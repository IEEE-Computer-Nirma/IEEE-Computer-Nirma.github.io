rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── CTF Leaderboard ───────────────────────────────────────────────
    // Collection: ctf_leaderboard
    // Each document is keyed by the user's Firebase UID.
    match /ctf_leaderboard/{uid} {

      // Anyone (including unauthenticated) can READ the leaderboard
      allow read: if true;

      // Only the authenticated user can CREATE or UPDATE their own document.
      // Also enforces that the uid field in the document matches the path.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;

      allow update: if request.auth != null
        && request.auth.uid == uid;

      // No one can delete leaderboard entries via client
      allow delete: if false;
    }
  }
}
